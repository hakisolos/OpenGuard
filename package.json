  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "nodemailer": "^8.0.7",
    "pm2": "^6.0.14"
  }
}
